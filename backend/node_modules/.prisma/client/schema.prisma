generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ─────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(uuid())
  firstName     String
  lastName      String
  email         String     @unique
  password      String
  role          Role       @default(STUDENT)
  status        UserStatus @default(PENDING)
  documentImage String?

  package   Package? @relation(fields: [packageId], references: [id])
  packageId String?

  reservations Reservation[]
  payments     Payment[]

  createdAt DateTime @default(now())
}

enum Role {
  STUDENT
  ADMIN
  AGENT_RESTAURANT
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Packages ─────────────────────────────────────────────────────────────────

model Package {
  id      String @id @default(uuid())
  name    String
  price   Float
  tickets Int

  users User[]
}

// ─── Meals & Reservations ─────────────────────────────────────────────────────

model Meal {
  id   String   @id @default(uuid())
  type MealType
  date DateTime

  reservations Reservation[]
}

enum MealType {
  LUNCH
  DINNER
}

model Reservation {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String
  meal   Meal   @relation(fields: [mealId], references: [id])
  mealId String

  date      DateTime
  createdAt DateTime          @default(now())
  status    ReservationStatus @default(PENDING)

  usedAt      DateTime?
  validatedBy String?
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  USED
  CANCELLED
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  amount    Float
  status    PaymentStatus
  createdAt DateTime      @default(now())
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

// ─── Recipes & Ingredients (Panel 1 — Créer un menu) ─────────────────────────

model Recipe {
  id    String     @id @default(uuid())
  label String
  type  RecipeType

  ingredients RecipeIngredient[]
  menuItems   MenuItem[]

  createdAt DateTime @default(now())
}

enum RecipeType {
  MAIN
  SALAD
  DESSERT
}

model RecipeIngredient {
  id       String @id @default(uuid())
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String

  name String
  qty  Float
  unit String // g, kg, ml, l, pcs, tsp, tbsp
}

// ─── Daily Menu Planning (Panel 2 — Planification) ───────────────────────────

model DailyMenu {
  id   String   @id @default(uuid())
  date DateTime @unique

  items MenuItem[]

  createdAt DateTime @default(now())
}

model MenuItem {
  id          String    @id @default(uuid())
  dailyMenu   DailyMenu @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  dailyMenuId String

  recipe   Recipe @relation(fields: [recipeId], references: [id])
  recipeId String

  mealType MealType // LUNCH or DINNER
}
